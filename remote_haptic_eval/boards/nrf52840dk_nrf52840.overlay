/*
 * DRV2605L wiring only -- P1.04 SDA / P1.05 SCL on i2c1, identical pin
 * choice and reasoning to remote/boards/nrf52840dk_nrf52840.overlay (i2c1
 * shares silicon with spi1/uart1, both unused; P1.04/05 rather than the
 * board's own arduino_i2c/i2c0 because P0.26/27 are spoken for on the real
 * remote board -- irrelevant here, but the pin choice is kept identical so
 * a breadboard wired for remote/BUILD_SPEC.md bring-up needs no rewiring
 * to be read by this eval firmware instead).
 */
#include <zephyr/dt-bindings/i2c/i2c.h>

&pinctrl {
	i2c1_default: i2c1_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 4)>,
				<NRF_PSEL(TWIM_SCL, 1, 5)>;
		};
	};
	i2c1_sleep: i2c1_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 4)>,
				<NRF_PSEL(TWIM_SCL, 1, 5)>;
			low-power-enable;
		};
	};
};

&i2c1 {
	status = "okay";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};
